/interface ethernet
set [ find default-name=ether1 ] comment=WAN-1 disable-running-check=no
set [ find default-name=ether2 ] disable-running-check=no
set [ find default-name=ether3 ] disable-running-check=no
set [ find default-name=ether4 ] comment=LAN disable-running-check=no

/interface bridge 
add name=lo0 comment="Loopback0"

/ip neighbor discovery-settings
set protocol=cdp,lldp,mndp

/ip address
add address=10.1.0.1/16 interface=ether4 network=10.1.0.0 comment="LAN-NET"
add address=1.1.1.1 interface=lo0 comment="Lo0" 

/interface pppoe-client disabled=no add-default-route=yes interface=ether1 name=LINK-1 user=user1 password=12345678 \
	profile=default allow=chap,mschap1,mschap2

/ip dns
set servers=1.1.1.1,1.0.0.1,208.67.222.222 comment="DNSs-Pub"

/ip firewall address-list
add address=192.168.122.0/24 list=list-1 comment="Rede-PPPoE-LIST"

/ip firewall filter
add action=accept chain=input comment="Permite o login no WINBOX" dst-port=8291 in-interface=ether1 \
    log=yes protocol=tcp src-address-list=list-1
add action=accept chain=input comment="Permite o login via ssh" dst-port=22 protocol=tcp

/ip firewall nat
add action=masquerade chain=srcnat

/routing ospf instance add name=instance0 disabled=no router-id=1.1.1.1 routing-table=main vrf=main version=2
/routing ospf area add disabled=no name=backbone area-id=0.0.0.0 type=default instance=instance0 
/routing ospf interface-template add disabled=no instance-id=0 area=backbone type=broadcast

/ip service
set telnet disabled=yes
set ftp disabled=yes
set www disabled=yes
set api disabled=yes
set api-ssl disabled=yes

/ip ssh
set forwarding-enabled=local host-key-size=8192

/system clock
set time-zone-autodetect=no time-zone-name=America/Sao_Paulo

/system ntp client servers
add address=200.160.7.186
/system ntp client
set enabled=yes

/system identity
set name=MK1
